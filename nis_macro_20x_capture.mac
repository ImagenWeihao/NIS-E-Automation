// ============================================================
// NIS-Elements Macro: 20X Spheroid Z-Stack Capture
// SpheroidPA Pipeline — Step 3
//
// Reads the ranked CSV produced by spheroid_screener.py and
// captures a 20X z-stack for every top-N spheroid in order of
// quality rank.
//
// Pre-requisites (configure in NIS-E BEFORE running this macro):
//   1. Switch objective turret to 20X
//   2. Open Acquisition > ND Experiment, configure:
//        • Z Series: start = 0, end = 0, step = 2 µm
//          (the macro overwrites these values at runtime)
//        • Channels: keep same as 10X scan
//        • Time Points: 1 (no time loop)
//   3. Set perfect focus / autofocus mode if desired
//   4. Set file save location in ND Experiment to the output folder
//      (the macro also calls Doc_SaveAs with the exact ranked name)
//
// CSV column order produced by spheroid_screener.py:
//   rank, position_idx, x_um, y_um, z_surface_um,
//   diameter_um, circularity, solidity, area_px, score,
//   cx_px, cy_px, pixel_um
//
// NIS-E Macro Language: C-style syntax (NIS-Elements 5.x / AR 2020+)
// Tested command equivalents for older versions are noted in comments.
// ============================================================

#pragma NoCancelOnError

// ── Macro-level configuration constants ──────────────────────────────────────

// Path to the CSV written by spheroid_screener.py.
// Screener always writes a fixed "latest" file here for the macro to read.
#define CSV_PATH     "C:\\NIS_Output\\spheroid_screen_latest.csv"

// Output folder for 20X nd2 files (trailing backslash required)
#define OUT_DIR      "C:\\NIS_Output\\20X_captures\\"

// How many top-ranked spheroids to capture (0 = capture all)
#define MAX_CAPTURE  5

// Z-range above / below the detected surface to include in the z-stack (µm).
// z_start = z_surface - Z_ABOVE
// z_end   = z_surface + diameter + Z_BELOW
#define Z_ABOVE      20.0
#define Z_BELOW      10.0
#define Z_STEP        2.0   // z-step size (µm)

// Stage settle and focus settle times (ms)
#define STAGE_SETTLE  800
#define FOCUS_SETTLE  400


// ── Macro entry point ─────────────────────────────────────────────────────────

void SpheroidScreen_20X_Capture()
{
    // Allow user to override the default paths at runtime
    string sCsvPath  = InputBox("Screener CSV path:", CSV_PATH);
    string sOutDir   = InputBox("Output folder (with trailing \\):", OUT_DIR);
    int    nMaxCapt  = StrToInt(InputBox("Top-N spheroids to capture (0=all):", IntToStr(MAX_CAPTURE)));

    if (StrLen(sCsvPath) == 0 || StrLen(sOutDir) == 0) {
        MessageBox("Cancelled — no path provided.");
        return;
    }

    // Ensure output directory exists
    CreateDirectory(sOutDir);

    // ── Open CSV ─────────────────────────────────────────────────────────────
    int hFile;
    hFile = FileOpen(sCsvPath, "r");
    if (hFile == 0) {
        MessageBox("Cannot open CSV:\n" + sCsvPath);
        return;
    }

    string sLine;
    int    nCaptured = 0;

    // Skip header row
    FileReadLine(hFile, sLine);

    // ── Iterate over spheroid positions ──────────────────────────────────────
    while (!FileEOF(hFile)) {

        if (nMaxCapt > 0 && nCaptured >= nMaxCapt)
            break;

        FileReadLine(hFile, sLine);
        sLine = StrTrim(sLine);
        if (StrLen(sLine) == 0) continue;
        if (StrLeft(sLine, 1) == "#") continue;   // skip comment lines

        // Parse CSV fields
        // rank, position_idx, x_um, y_um, z_surface_um,
        // diameter_um, circularity, solidity, area_px, score, ...
        string fields[20];
        int nFields = StrSplit(sLine, ",", fields, 20);
        if (nFields < 5) continue;

        int    nRank      = StrToInt  (StrTrim(fields[0]));
        int    nPosIdx    = StrToInt  (StrTrim(fields[1]));
        double dX         = StrToFloat(StrTrim(fields[2]));
        double dY         = StrToFloat(StrTrim(fields[3]));
        double dZSurface  = StrToFloat(StrTrim(fields[4]));
        double dDiam      = StrToFloat(StrTrim(fields[5]));
        double dScore     = (nFields > 9) ? StrToFloat(StrTrim(fields[9])) : 0.0;

        // Compute z-stack bounds from spheroid geometry
        double dZStart = dZSurface - Z_ABOVE;
        double dZEnd   = dZSurface + dDiam + Z_BELOW;

        // ── Configure the ND experiment z-stack range ─────────────────────
        // These functions set the Z-Series parameters in the active ND Experiment.
        // If your NIS-E version uses different names, check:
        //   Help > Macro Functions > ND Experiment functions
        ND_SetZSeriesRange(dZStart, dZEnd, Z_STEP);

        // ── Move stage to spheroid position ──────────────────────────────
        Stg_MoveXY(dX, dY);
        Wait(STAGE_SETTLE);

        // Move Z focus to surface (ND z-series starts from dZStart anyway,
        // but setting Z here gives autofocus a good starting point)
        Stg_MoveZ(dZSurface);
        Wait(FOCUS_SETTLE);

        // ── Run z-stack acquisition ───────────────────────────────────────
        // NdCapture() runs the configured ND Experiment (z-series + channels).
        // Equivalent in some versions: NdRun(), RunNdExperiment(), Grab()
        NdCapture();

        // ── Save result ───────────────────────────────────────────────────
        // Build filename: rank, position, score
        // e.g. "sph_rank01_pos0_score0p947.nd2"
        string sScoreStr = FloatToStr(dScore, 3);
        // Replace "." with "p" so the dot in the score is not confused with
        // the file extension dot.
        StrReplace(sScoreStr, ".", "p");

        string sSavePath = sOutDir
            + "sph_rank" + IntToStr2(nRank,    2)
            + "_pos"     + IntToStr (nPosIdx)
            + "_score"   + sScoreStr
            + ".nd2";

        // Doc_SaveAs saves the current (most-recently-acquired) document.
        // Equivalent in some versions: SaveAs(), Nd2_Save(), NdSave()
        Doc_SaveAs(sSavePath);

        nCaptured++;

        // Progress indicator in the NIS-E status bar
        StatusBar("Spheroid " + IntToStr(nRank) + " / "
                  + IntToStr(nMaxCapt > 0 ? nMaxCapt : 99)
                  + " captured.");
    }

    FileClose(hFile);

    MessageBox("Done.\n"
        + IntToStr(nCaptured) + " spheroid(s) acquired.\n"
        + "Files saved to: " + sOutDir);
}


// ── Helper: set z-series range in the active ND Experiment ───────────────────
//
// NIS-E exposes the ND Experiment through a scripting interface.
// The exact function name varies:
//   NIS-E 5.x AR 2020+  : ND_SetZSeriesRange(start, end, step)
//   Older NIS-E          : ND.ZSeries.StartPos = ...; ND.ZSeries.EndPos = ...;
// If neither works, configure the Z range manually in the ND Acquisition dialog
// before running this macro and comment out the ND_SetZSeriesRange call above.
//
// This stub is a no-op placeholder that documents the intent; replace with
// the exact call that works in your NIS-E version.

void ND_SetZSeriesRange(double dStart, double dEnd, double dStep)
{
    // Option A — NIS-E 5.x C-macro interface (most common):
    //   (uncomment if your version supports these)
    // ND.ZSeries.Start = dStart;
    // ND.ZSeries.End   = dEnd;
    // ND.ZSeries.Step  = dStep;

    // Option B — older macro function syntax:
    // ZStackSetStart(dStart);
    // ZStackSetEnd(dEnd);
    // ZStackSetStep(dStep);

    // Option C — manual: delete this function, set range in the ND dialog,
    // and only use this macro for stage positioning + acquisition trigger.

    // Default no-op: relies on pre-configured ND Experiment settings.
    // The correct z-start is still enforced by Stg_MoveZ(dZSurface) above.
}


// ── Helper: zero-padded integer to string ─────────────────────────────────────

string IntToStr2(int n, int width)
{
    string s = IntToStr(n);
    while (StrLen(s) < width)
        s = "0" + s;
    return s;
}
