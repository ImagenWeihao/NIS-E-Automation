// 04_capture_save.mac -- self-test: single capture + ND2 save
// Validates: Capture, ImageSaveAs
// Acquires ONE frame and writes it to disk. Camera must NOT be in Live mode.

#define OUT_PATH     "C:/SpheroidPA/work/nd2/selftest_capture.nd2"
#define SAVE_NDTYPE  14    // 14 = all layers (ND2)
#define SAVE_NDCOMPR 0     // 0 = lossless

int main()
{
    WaitText(0, "t04 ENTER: click Continue to Capture one frame (camera must be OUT of Live).");
    Capture();
    WaitText(0, "Capture returned. Click Continue to save it with ImageSaveAs.");
    ImageSaveAs(OUT_PATH, SAVE_NDTYPE, SAVE_NDCOMPR);
    WaitText(0, "ImageSaveAs done.\n\nt04 PASS if a frame was acquired and saved to:\nC:/SpheroidPA/work/nd2/selftest_capture.nd2");
    return TRUE;
}
