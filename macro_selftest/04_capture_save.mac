// 04_capture_save.mac -- self-test: single capture + ND2 save
// Validates: Capture, ImageSaveAs
// Acquires ONE frame and writes it to disk. Camera must NOT be in Live mode.
//
// Rig-tested notes:
//   - Do NOT hold a dotted path in a #define ("...nd2" -> "Cannot Evaluate the
//     Expression" on this build). Build the path with strcpy + strcat literals.
//   - ImType 14 = All layers (ND2), ImCompr 0 = lossless, passed as int literals.
//   - If this still errors on ImageSaveAs, Capture() left no current image
//     -> check the camera is configured and OUT of Live.

int main()
{
    char path[256];

    strcpy(path, "S:/Images/Weihao/NISeA/NIS-E-Automation/work/nd2");
    strcat(path, "/selftest_capture.nd2");

    WaitText(0, "t04 ENTER: click Continue to Capture one frame (camera must be OUT of Live).");
    Capture();
    WaitText(0, "Capture returned. Click Continue to save with ImageSaveAs(path, 14, 0).");
    ImageSaveAs(path, 14, 0);
    WaitText(0, "ImageSaveAs done.\n\nt04 PASS if a frame was acquired and saved to:\nS:/Images/Weihao/NISeA/NIS-E-Automation/work/nd2/selftest_capture.nd2");
    return TRUE;
}
