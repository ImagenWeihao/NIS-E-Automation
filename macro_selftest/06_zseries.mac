// 06_zseries.mac -- self-test: program + run a small Z-series WITH Z-intensity correction
// Validates the capture core of nis_macro_auto_capture.mac:
//   ND_SetZSeriesExp, ND_RunZSeriesExpWithZIntensityCorrection, ImageSaveAs
// CAUTION: real acquisition. Small range (+/- 4 um around the CURRENT Z).
// PREREQ: run 05_zintensity.mac first so a correction profile is loaded.
// NOTE: path built with strcpy+strcat literals; int args passed as literals.

int main()
{
    char out[256];
    char path[256];
    double z_centre, z_top, z_bottom, zstep;

    strcpy(path, "S:/Images/Weihao/NISeA/NIS-E-Automation/work/nd2");
    strcat(path, "/selftest_zseries.nd2");

    zstep    = 2.0;
    z_centre = 0;
    StgGetAbsPosZ(&z_centre);
    z_top    = z_centre + 4.0;
    z_bottom = z_centre - 4.0;

    sprintf(out, "t06 ENTER: Z-series from %.2f to %.2f um (step %.1f) around current Z. Continue to PROGRAM.", "z_bottom,z_top,zstep");
    WaitText(0, out);

    ND_SetZSeriesExp(0, z_top, z_centre, z_bottom, zstep, 0, 0, 0, "", "", "");
    WaitText(0, "ND_SetZSeriesExp programmed. Click Continue to RUN the plain Z-series.");

    // NOTE: ND_RunZSeriesExpWithZIntensityCorrection() raised "Cannot Evaluate the
    // Expression" on this rig (the corrected run appears A1/confocal-only; the panel
    // also shows "Incompatible Z Correction and Camera"). Test the PLAIN run here:
    ND_RunZSeriesExp();
    WaitText(0, "ND_RunZSeriesExp (plain) returned. Click Continue to save the result.");

    ImageSaveAs(path, 14, 0);
    WaitText(0, "Saved.\n\nt06 PASS if a multi-plane ND2 was acquired with correction and saved to:\nS:/Images/Weihao/NISeA/NIS-E-Automation/work/nd2/selftest_zseries.nd2");
    return TRUE;
}
