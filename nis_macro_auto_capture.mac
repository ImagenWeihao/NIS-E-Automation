// ============================================================================
// nis_macro_auto_capture.mac  --  SpheroidPA STEP 4 capture daemon
// NIS-Elements AR macro (C-like interpreted dialect). Entry point: main().
//
// Verified against the local NIS-E AR 5.42 macro function reference
// (Docs/nis/eng_ar). Every NIS function call below exists in that reference;
// string/number helpers (sprintf/strcpy/strcat/atof) are standard C.
//
// PURPOSE
//   Poll WORK_DIR for spheroid_trigger.ini. When present:
//     1. read [spheroid] keys (rank, spheroid_id, stage_x/y, z_centre,
//        z_half, z_step, bin_path, nd2_out)
//     2. enable + load the Z-intensity correction profile (bin_path)
//     3. program an absolute Bottom-Top Z-series:
//        bottom = z_centre - z_half, top = z_centre + z_half, step = z_step
//     4. move the XY stage to (stage_x, stage_y) and settle
//     5. run the Z-series capture WITH Z-intensity correction
//     6. save the result to nd2_out (all-layers ND2)
//     7. write spheroid_done.ini ([spheroid]: rank, spheroid_id, nd2_path,
//        status) and delete the trigger
//   Loop until no trigger is seen for IDLE_TIMEOUT_S seconds.
//
// FILE-FLAG PROTOCOL  (INI files carry a [spheroid] section header, written
// by spheroid_pipeline.py so Int_GetKeyString/Int_GetKeyValue can read them)
//   spheroid_trigger.ini (input):  rank, spheroid_id, stage_x, stage_y,
//     z_centre, z_half, z_step, bin_path, nd2_out, timestamp
//   spheroid_done.ini (output):    rank, spheroid_id, nd2_path, status
//     status = ok | error | zcorr_not_ready | move_failed
//
// PREREQUISITES (configure in NIS-E BEFORE running)
//   - 20X objective selected; ND channels configured in ND Acquisition.
//   - XY + Z stages connected, initialized, in automatic mode.
//   - Camera NOT in Live mode (capture/run functions freeze if Live is on).
//   - Z Intensity Correction enabled in the ND Acq. dialog.
//   - WORK_DIR below must equal the Trigger dir set in the SpheroidPA GUI.
//
// HARDWARE-VERIFY ITEMS (resolve on the real NIS-E system)
//   *** CORRECTION FILE FORMAT ***
//   The pipeline produces a .bin (csv_to_nis_bin.py). The documented loaders
//   are ND_ZIntensityControlLoad(.xml) and ND_ReuseZIntensityCorr(.nd2);
//   neither doc lists .bin. On this rig the Z Intensity Correction PANEL uses
//   .bin natively, so we pass bin_path to ND_ZIntensityControlLoad. If that
//   call rejects .bin, either (a) have csv_to_nis_bin.py emit the format the
//   panel's Load accepts, or (b) switch to ND_ReuseZIntensityCorr against a
//   reference .nd2.  // VERIFY: ND_ZIntensityControlLoad accepts the .bin path
//
//   ND_ZIntensityControlIsDataReady() is documented for A1/multilaser systems.
//   On other systems it may always return 0; if so, set CHECK_ZREADY 0.
//
// NIS-E NOTE: logical operators (&& || !) bind right-to-left in this
// interpreter, so every logical sub-expression below is fully bracketed.
// ============================================================================

// ---- CONFIG (edit to match the rig) ----------------------------------------
#define WORK_DIR        "C:/SpheroidPA/work"
#define SEC             "spheroid"
#define POLL_SECONDS    1.0
#define IDLE_TIMEOUT_S  600.0

#define ZTYPE_BOTTOMTOP 0     // ND_SetZSeriesExp type: absolute bottom-top
#define MOVE_ABSOLUTE   0     // StgMoveXY relative flag
#define DR_OK           1     // Stg* success return code
#define CHECK_ZREADY    1     // 1 = abort if Z-intensity data not ready

// ImageSaveAs: ImType 14 = all layers (ND2); ImCompr 0 = lossless.
#define SAVE_NDTYPE     14
#define SAVE_NDCOMPR    0

global char Trigger_Path[256];
global char Done_Path[256];

// ---- build the trigger/done paths from WORK_DIR ----------------------------
int build_paths()
{
    strcpy(Trigger_Path, WORK_DIR);
    strcat(Trigger_Path, "/spheroid_trigger.ini");
    strcpy(Done_Path, WORK_DIR);
    strcat(Done_Path, "/spheroid_done.ini");
    return TRUE;
}

// ---- write spheroid_done.ini fresh (clears any stale keys first) -----------
int write_done(char *rank_buf, char *spheroid_id, char *nd2_path, char *status)
{
    DeleteFile(Done_Path);
    Int_SetKeyString(Done_Path, SEC, "rank", rank_buf);
    Int_SetKeyString(Done_Path, SEC, "spheroid_id", spheroid_id);
    Int_SetKeyString(Done_Path, SEC, "nd2_path", nd2_path);
    Int_SetKeyString(Done_Path, SEC, "status", status);
    return TRUE;
}

// ---- process one trigger ---------------------------------------------------
int process_trigger()
{
    char spheroid_id[128];
    char bin_path[256];
    char nd2_out[256];
    char rank_buf[32];
    char numbuf[64];
    double stage_x, stage_y;
    double z_centre, z_half, z_step;
    double z_top, z_bottom;
    int move_rc;

    rank_buf[0]    = 0;
    spheroid_id[0] = 0;
    bin_path[0]    = 0;
    nd2_out[0]     = 0;

    Int_GetKeyString(Trigger_Path, SEC, "rank", rank_buf, 32);
    Int_GetKeyString(Trigger_Path, SEC, "spheroid_id", spheroid_id, 128);
    Int_GetKeyString(Trigger_Path, SEC, "bin_path", bin_path, 256);
    Int_GetKeyString(Trigger_Path, SEC, "nd2_out", nd2_out, 256);

    // Read numeric keys as strings + atof. Int_GetKeyValue raises
    // "Mismatch in dimensions" on this NIS-E build.
    Int_GetKeyString(Trigger_Path, SEC, "stage_x", numbuf, 64);
    stage_x = atof(numbuf);
    Int_GetKeyString(Trigger_Path, SEC, "stage_y", numbuf, 64);
    stage_y = atof(numbuf);
    Int_GetKeyString(Trigger_Path, SEC, "z_centre", numbuf, 64);
    z_centre = atof(numbuf);
    Int_GetKeyString(Trigger_Path, SEC, "z_half", numbuf, 64);
    z_half = atof(numbuf);
    Int_GetKeyString(Trigger_Path, SEC, "z_step", numbuf, 64);
    z_step = atof(numbuf);

    SetCommandText("SpheroidPA capture: loading Z-intensity correction");

    // Enable + load the per-spheroid Z-intensity correction profile.
    EnableZIntensityControl(1);
    ND_ZIntensityControlLoad(bin_path);

    // Optional readiness guard (A1/multilaser systems).
    if( CHECK_ZREADY == 1 )
    {
        if( ND_ZIntensityControlIsDataReady() == 0 )
        {
            write_done(rank_buf, spheroid_id, "", "zcorr_not_ready");
            DeleteFile(Trigger_Path);
            SetCommandText("SpheroidPA capture: Z-intensity data NOT ready - skipped");
            return TRUE;
        }
    }

    // Program the absolute Bottom-Top Z-series centred on z_centre.
    z_top    = z_centre + z_half;
    z_bottom = z_centre - z_half;
    ND_SetZSeriesExp(ZTYPE_BOTTOMTOP, z_top, z_centre, z_bottom,
                     z_step, 0, 0, 0, "", "", "");

    // Move XY stage (absolute, microns), then wait the stage settle time.
    move_rc = StgMoveXY(stage_x, stage_y, MOVE_ABSOLUTE);
    if( move_rc != DR_OK )
    {
        write_done(rank_buf, spheroid_id, "", "move_failed");
        DeleteFile(Trigger_Path);
        SetCommandText("SpheroidPA capture: XY move FAILED - skipped");
        return TRUE;
    }
    Wait(StgXY_GetSettleTime() / 1000.0);

    SetCommandText("SpheroidPA capture: running Z-series with Z-intensity correction");

    // Run the Z-stack with Z intensity correction, then save as ND2.
    ND_RunZSeriesExpWithZIntensityCorrection();
    ImageSaveAs(nd2_out, SAVE_NDTYPE, SAVE_NDCOMPR);

    write_done(rank_buf, spheroid_id, nd2_out, "ok");
    DeleteFile(Trigger_Path);

    SetCommandText("SpheroidPA capture: done, waiting for next trigger");
    return TRUE;
}

int main()
{
    double idle_elapsed;

    build_paths();
    idle_elapsed = 0.0;
    SetCommandText("SpheroidPA capture daemon: polling for spheroid_trigger.ini");

    while( idle_elapsed < IDLE_TIMEOUT_S )
    {
        if( ExistFile(Trigger_Path) == TRUE )
        {
            process_trigger();
            idle_elapsed = 0.0;
        }
        else
        {
            Wait(POLL_SECONDS);
            idle_elapsed = idle_elapsed + POLL_SECONDS;
        }
    }

    SetCommandText(0);
    return TRUE;
}
