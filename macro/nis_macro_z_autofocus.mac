// ============================================================================
// nis_macro_z_autofocus.mac  --  SpheroidPA STEP 3 autofocus daemon
// NIS-Elements AR macro (C-like interpreted language).
//
// IMPORTANT (verified on the rig): this NIS-E build runs only a SINGLE main()
// -- user-defined functions/procedures (even parameterless) raise "Cannot
// Evaluate the Expression". So all logic is inline in main(). Other hard-won
// constraints baked in here:
//   - .mac files must be CRLF + pure ASCII.
//   - #define values containing '-' or '.' (paths) fail "Cannot Evaluate the
//     Expression"; the work dir is therefore a direct string literal below.
//   - Int_GetKeyValue raises "Mismatch in dimensions": read numeric keys as
//     strings with Int_GetKeyString then atof().
//   - sprintf is not C-variadic: pass args as ONE quoted comma-separated string
//     of variable names, e.g. sprintf(buf, "%s %s", "a,b").
//   - all variable declarations at the top of main() (no mid-block decls).
//
// PURPOSE
//   Poll the autofocus work dir for af_trigger_NN.ini (NN = 01..96). For each:
//     read [spheroid] rank/spheroid_id/stage_x/stage_y, move XY, two-pass
//     autofocus, read absolute Z, capture a plane, save <id>_af.nd2, write
//     af_done_NN.ini (rank, spheroid_id, z_centre, nd2_path, status), delete trigger.
//   status = ok | af_failed | move_failed.  Loop until idle 300 s.
//
// PREREQUISITES: 20X objective; XY+Z stages initialized; Z drive NOT in Escape;
//   camera NOT in Live. Brightfield focus criterion (0); 2=fluorescence, 3=noisy.
//   The work dir below must equal <GUI Step 1 Output dir>/autofocus.
// ============================================================================

#define SEC "spheroid"

int main()
{
    char work_dir[256];
    char cfg[256];
    char trigger_path[256];
    char done_path[256];
    char nd2_path[256];
    char spheroid_id[128];
    char rank_buf[16];
    char numbuf[64];
    char zbuf[64];
    char nn[8];
    char status[32];
    char status_msg[256];
    char mbuf[512];
    double stage_x, stage_y, z_centre;
    double idle_elapsed;
    int rank, move_rc, af_result, handled_any, ok_flag;

    // Trigger dir is NOT hardcoded: follow the GUI's session.ini (Step 1 save dir),
    // matching nis_macro_capture_zstack.mac so the dispatcher can route this macro
    // to whatever run folder the GUI is using.
    strcpy(cfg, "C:/SpheroidPA/session.ini");
    work_dir[0] = 0;
    Int_GetKeyString(cfg, "paths", "work_dir", work_dir, 256);
    if( work_dir[0] == 0 )
    {
        SetCommandText("session.ini has no work_dir.\nRun GUI Step 3 (Trigger) first, then re-run this macro.");
        WideCharToMultiByte(mbuf, "session.ini has no work_dir.\nRun GUI Step 3 (Trigger) first, then re-run this macro.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("session.ini has no work_dir.\nRun GUI Step 3 (Trigger) first, then re-run this macro."));
        return FALSE;
    }
    idle_elapsed = 0.0;

    while( idle_elapsed < 300.0 )
    {
        handled_any = FALSE;
        rank = 1;
        while( rank <= 96 )
        {
            sprintf(nn, "%02d", "rank");
            strcpy(trigger_path, work_dir);
            strcat(trigger_path, "/af_trigger_");
            strcat(trigger_path, nn);
            strcat(trigger_path, ".ini");

            if( ExistFile(trigger_path) == TRUE )
            {
                handled_any = TRUE;

                spheroid_id[0] = 0;
                rank_buf[0]    = 0;
                Int_GetKeyString(trigger_path, SEC, "spheroid_id", spheroid_id, 128);
                Int_GetKeyString(trigger_path, SEC, "rank", rank_buf, 16);
                Int_GetKeyString(trigger_path, SEC, "stage_x", numbuf, 64);
                stage_x = atof(numbuf);
                Int_GetKeyString(trigger_path, SEC, "stage_y", numbuf, 64);
                stage_y = atof(numbuf);

                sprintf(status_msg, "AF rank %s (%s): moving stage", "rank_buf,spheroid_id");
                SetCommandText(status_msg);

                strcpy(done_path, work_dir);
                strcat(done_path, "/af_done_");
                strcat(done_path, nn);
                strcat(done_path, ".ini");

                ok_flag    = 0;
                z_centre   = 0.0;
                nd2_path[0] = 0;

                move_rc = StgMoveXY(stage_x, stage_y, 0);
                if( move_rc != 1 )
                {
                    strcpy(status, "move_failed");
                    SetCommandText("AF: XY move FAILED - skipped");
                }
                else
                {
                    // Pre-position Z to ~7600 um, then a two-pass autofocus over
                    // +/-100 um (200 um total) with a 10 um coarse step -> searches
                    // 7500..7700 um. Criterion 3 = noise-resistant: estimates the
                    // image noise floor and ignores it, best for weak/low-count
                    // fluorescence (no exposure/illumination change needed).
                    StgMoveZ(7600.0, 0);
                    StgFocusSetCriterion(3);
                    af_result = StgFocusInRangeTwoPasses(200.0, 10.0, 3.0);
                    if( af_result != 1 )
                    {
                        strcpy(status, "af_failed");
                        SetCommandText("AF: focus FAILED - skipped");
                    }
                    else
                    {
                        ok_flag = 1;
                        strcpy(status, "ok");
                        StgGetAbsPosZ(&z_centre);
                        SetCommandText("AF: capturing single plane");
                        Capture();
                        strcpy(nd2_path, work_dir);
                        strcat(nd2_path, "/");
                        strcat(nd2_path, spheroid_id);
                        strcat(nd2_path, "_af.nd2");
                        ImageSaveAs(nd2_path, 14, 0);
                    }
                }

                DeleteFile(done_path);
                Int_SetKeyString(done_path, SEC, "rank", rank_buf);
                Int_SetKeyString(done_path, SEC, "spheroid_id", spheroid_id);
                if( ok_flag == 1 )
                {
                    sprintf(zbuf, "%.3f", "z_centre");
                    Int_SetKeyString(done_path, SEC, "z_centre", zbuf);
                    Int_SetKeyString(done_path, SEC, "nd2_path", nd2_path);
                }
                Int_SetKeyString(done_path, SEC, "status", status);
                DeleteFile(trigger_path);
            }
            rank = rank + 1;
        }

        if( handled_any == TRUE )
        {
            idle_elapsed = 0.0;
        }
        else
        {
            SetCommandText("AF daemon: idle, waiting for triggers");
            Wait(1.0);
            idle_elapsed = idle_elapsed + 1.0;
        }
    }

    SetCommandText(0);
    return TRUE;
}
