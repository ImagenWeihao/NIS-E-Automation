// ============================================================================
// nis_macro_pa_points.mac -- SpheroidPA: build the ND multipoint for PA
//
// Reads EVERY af_trigger_01..96.ini currently present in the session work_dir
// (i.e. whatever GUI Step 3 last wrote for its checked selection) and builds the
// ND multipoint experiment (ND_ResetMultipointExp + ND_AppendMultipointPoint per
// spheroid). The step3_zstack_PA JOB can then "Import Point Set from ND" and
// photoactivate every point in one run.
//
// No separate count/selection of its own -- Step 3's checkbox table + "Trigger"
// button IS the selection (it clears all stale af_trigger_*/af_done_* first, so
// autofocus/ always reflects exactly the current checked rows). This macro just
// mirrors whatever is active there. To PA a different subset, check/uncheck rows
// in Step 3 and click Trigger again before running this. Pair with
// nis_macro_pa_setup (hardware prep), run once before the job.
//
// DIAGNOSTIC BUILD (2026-07-09): drops a breadcrumb into work_dir/
// pa_points_progress.ini after every step. If a silent ND_ runtime error aborts
// the macro before its confirmation popup (symptom: cmd_done.ini=ok written by
// the dispatcher, but no NIS-E "N spheroid(s)" popup and the ND multipoint stays
// empty), the LAST stage recorded there is the line it died on. Kept in a
// separate file so it does NOT collide with the dispatcher/GUI cmd_done.ini
// completion handshake (the GUI polls cmd_done.ini for existence; writing to it
// mid-macro would trip a premature "completed" read).
//
// Rig dialect (verified): single main() only; CRLF + ASCII; Int_GetKeyString +
// atof for INI values; sprintf args as one quoted comma-list of variable names.
// Stage X/Y/Z are taken from the triggers (same um coords that drove captures).
// ============================================================================

#define SEC "spheroid"

int main()
{
    char cfg[256];
    char work_dir[256];
    char prog[256];
    char tp[256];
    char nn[8];
    char id[128];
    char numbuf[64];
    char msg[256];
    char mbuf[512];
    double x, y, z;
    int i, added;

    strcpy(cfg, "C:/SpheroidPA/session.ini");
    work_dir[0] = 0;
    Int_GetKeyString(cfg, "paths", "work_dir", work_dir, 256);
    if( work_dir[0] == 0 )
    {
        SetCommandText("session.ini has no work_dir.\nRun GUI Step 3 first.");
        WideCharToMultiByte(mbuf, "session.ini has no work_dir.\nRun GUI Step 3 first.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("session.ini has no work_dir.\nRun GUI Step 3 first."));
        return FALSE;
    }

    // Breadcrumb file -- last "stage" value written = last line reached before any
    // silent abort. Read it back after the run to pinpoint the failing call.
    strcpy(prog, work_dir);
    strcat(prog, "/pa_points_progress.ini");
    DeleteFile(prog);
    Int_SetKeyString(prog, "progress", "stage", "1_entered");

    Int_SetKeyString(prog, "progress", "stage", "2_before_reset");
    ND_ResetMultipointExp();
    Int_SetKeyString(prog, "progress", "stage", "3_after_reset");

    // Scan the full rank range (1..96) and add every trigger found -- no count cap,
    // mirrors Step 3's active selection exactly, whatever ranks it contains.
    added = 0;
    i = 1;
    while( i <= 96 )
    {
        sprintf(nn, "%02d", "i");
        strcpy(tp, work_dir);
        strcat(tp, "/af_trigger_");
        strcat(tp, nn);
        strcat(tp, ".ini");
        if( ExistFile(tp) == TRUE )
        {
            id[0] = 0;
            Int_GetKeyString(tp, SEC, "spheroid_id", id, 128);
            Int_GetKeyString(tp, SEC, "stage_x", numbuf, 64);
            x = atof(numbuf);
            Int_GetKeyString(tp, SEC, "stage_y", numbuf, 64);
            y = atof(numbuf);
            Int_GetKeyString(tp, SEC, "z_centre", numbuf, 64);
            z = atof(numbuf);
            Int_SetKeyString(prog, "progress", "last_id", id);
            Int_SetKeyString(prog, "progress", "stage", "4_before_append");
            ND_AppendMultipointPoint(x, y, z, id);
            Int_SetKeyString(prog, "progress", "stage", "5_after_append");
            added = added + 1;
        }
        i = i + 1;
    }

    sprintf(numbuf, "%d", "added");
    Int_SetKeyString(prog, "progress", "added", numbuf);
    Int_SetKeyString(prog, "progress", "stage", "7_done");

    if( added == 0 )
    {
        SetCommandText("No active af_trigger_*.ini found in work_dir -- built an EMPTY ND multipoint.\nCheck rows in Step 3's table and click 'Trigger' first.");
        WideCharToMultiByte(mbuf, "No active af_trigger_*.ini found in work_dir -- built an EMPTY ND multipoint.\nCheck rows in Step 3's table and click 'Trigger' first.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("No active af_trigger_*.ini found in work_dir -- built an EMPTY ND multipoint.\nCheck rows in Step 3's table and click 'Trigger' first."));
    }
    else
    {
        sprintf(msg, "Built ND multipoint with %d spheroid(s) (all active Step 3 triggers).\nIn step3_zstack_PA: Import Point Set from ND, then Run.", "added");
        SetCommandText(msg);
        WideCharToMultiByte(mbuf, msg);
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen(msg));
    }
    return TRUE;
}
