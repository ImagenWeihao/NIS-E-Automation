// ============================================================================
// nis_macro_capture_zcorrected.mac -- SpheroidPA Step 4 capture daemon
//   A1 confocal Z-stack WITH Z-intensity correction (Beer-Lambert depth comp).
//
// Pairs with GUI Step 4 "Start Capture Queue": Python writes ONE
// spheroid_trigger.ini at a time (rank/spheroid_id/stage_x/stage_y/z_centre/
// z_half/z_step/bin_path/nd2_out), this macro images it and writes
// spheroid_done.ini (status + nd2_path), Python deletes done + writes the next.
//
// Per trigger: read everything, DELETE the trigger (so the queue's next trigger
// is never clobbered), move XY, load that spheroid's Z-correction .bin
// (ND_ZIntensityControlLoad), confirm ready, run a Z-intensity-corrected
// Z-series (ND_RunZSeriesExpWithZIntensityCorrection), save nd2_out, write done.
//
// Rig constraints (verified): single main() only (no user functions); CRLF+ASCII;
// trigger dir read at runtime from C:/SpheroidPA/session.ini (no hardcoded path);
// Int_GetKeyString+atof for numbers; char[] paths + int literals; sprintf args as
// one quoted name list. Z-intensity correction is A1/confocal-ONLY.
//
// PREREQ: A1 confocal active; 20X objective; PFS OFF; Z drive not in Escape;
// the per-spheroid .bin files generated by GUI Step 4 (Generate All Bins, with a
// valid rig-exported Reference .bin).
// ============================================================================

#define SEC "spheroid"

int main()
{
    char cfg[256];
    char work_dir[256];
    char trigger_path[256];
    char done_path[256];
    char bin_path[256];
    char nd2_out[256];
    char spheroid_id[128];
    char rank_buf[16];
    char numbuf[64];
    char msg[256];
    char mbuf[512];
    double stage_x, stage_y;
    double z_centre, z_half, z_step, z_top, z_bottom;
    double idle_elapsed;
    int move_rc, ready;

    // Trigger dir is not hardcoded: follow the GUI's session.ini (Step 1 save dir).
    strcpy(cfg, "C:/SpheroidPA/session.ini");
    work_dir[0] = 0;
    Int_GetKeyString(cfg, "paths", "work_dir", work_dir, 256);
    if( work_dir[0] == 0 )
    {
        SetCommandText("session.ini has no work_dir.\nRun GUI Step 3 first, then start the Step 4 capture queue.");
        WideCharToMultiByte(mbuf, "session.ini has no work_dir.\nRun GUI Step 3 first, then start the Step 4 capture queue.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("session.ini has no work_dir.\nRun GUI Step 3 first, then start the Step 4 capture queue."));
        return FALSE;
    }

    strcpy(trigger_path, work_dir);
    strcat(trigger_path, "/spheroid_trigger.ini");
    strcpy(done_path, work_dir);
    strcat(done_path, "/spheroid_done.ini");

    idle_elapsed = 0.0;

    while( idle_elapsed < 600.0 )
    {
        if( ExistFile(trigger_path) == TRUE )
        {
            idle_elapsed = 0.0;

            // 1) Read EVERYTHING first, then delete the trigger -- the Python queue
            //    rewrites spheroid_trigger.ini only after it sees spheroid_done.ini,
            //    so deleting now can never drop the next spheroid's trigger.
            spheroid_id[0] = 0;
            rank_buf[0]    = 0;
            bin_path[0]    = 0;
            nd2_out[0]     = 0;
            Int_GetKeyString(trigger_path, SEC, "spheroid_id", spheroid_id, 128);
            Int_GetKeyString(trigger_path, SEC, "rank", rank_buf, 16);
            Int_GetKeyString(trigger_path, SEC, "bin_path", bin_path, 256);
            Int_GetKeyString(trigger_path, SEC, "nd2_out", nd2_out, 256);
            Int_GetKeyString(trigger_path, SEC, "stage_x", numbuf, 64);
            stage_x = atof(numbuf);
            Int_GetKeyString(trigger_path, SEC, "stage_y", numbuf, 64);
            stage_y = atof(numbuf);
            Int_GetKeyString(trigger_path, SEC, "z_centre", numbuf, 64);
            z_centre = atof(numbuf);
            if( z_centre == 0.0 )
                z_centre = 7680.0;
            Int_GetKeyString(trigger_path, SEC, "z_half", numbuf, 64);
            z_half = atof(numbuf);
            if( z_half == 0.0 )
                z_half = 90.0;
            Int_GetKeyString(trigger_path, SEC, "z_step", numbuf, 64);
            z_step = atof(numbuf);
            if( z_step == 0.0 )
                z_step = 10.0;
            z_top    = z_centre + z_half;
            z_bottom = z_centre - z_half;

            DeleteFile(trigger_path);

            sprintf(msg, "Step 4 rank %s (%s): Z-corrected capture", "rank_buf,spheroid_id");
            SetCommandText(msg);

            // 2) Move to the spheroid.
            move_rc = StgMoveXY(stage_x, stage_y, 0);
            if( move_rc != 1 )
            {
                DeleteFile(done_path);
                Int_SetKeyString(done_path, SEC, "rank", rank_buf);
                Int_SetKeyString(done_path, SEC, "spheroid_id", spheroid_id);
                Int_SetKeyString(done_path, SEC, "status", "move_failed");
            }
            else
            {
                // 3) Load this spheroid's Z-intensity correction (.bin) and confirm ready.
                EnableZIntensityControl(1);
                ND_ZIntensityControlLoad(bin_path);
                ready = ND_ZIntensityControlIsDataReady();
                if( ready != 1 )
                {
                    DeleteFile(done_path);
                    Int_SetKeyString(done_path, SEC, "rank", rank_buf);
                    Int_SetKeyString(done_path, SEC, "spheroid_id", spheroid_id);
                    Int_SetKeyString(done_path, SEC, "bin_path", bin_path);
                    Int_SetKeyString(done_path, SEC, "status", "zcorr_not_ready");
                }
                else
                {
                    // 4) Z-intensity-corrected Z-series, then save.
                    ND_SetZSeriesExp(0, z_top, z_centre, z_bottom, z_step, 0, 0, 0, "", "", "");
                    ND_RunZSeriesExpWithZIntensityCorrection();
                    DeleteFile(nd2_out);
                    ImageSaveAs(nd2_out, 14, 0);

                    DeleteFile(done_path);
                    Int_SetKeyString(done_path, SEC, "rank", rank_buf);
                    Int_SetKeyString(done_path, SEC, "spheroid_id", spheroid_id);
                    Int_SetKeyString(done_path, SEC, "nd2_path", nd2_out);
                    Int_SetKeyString(done_path, SEC, "status", "ok");
                }
            }
        }
        else
        {
            SetCommandText("Step 4 capture daemon: idle, waiting for spheroid_trigger.ini");
            Wait(1.0);
            idle_elapsed = idle_elapsed + 1.0;
        }
    }

    SetCommandText(0);
    return TRUE;
}
