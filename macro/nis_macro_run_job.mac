// ============================================================================
// nis_macro_run_job.mac -- SpheroidPA: launch a NIS-E JOB by name
//
// Dispatcher action_id 10. Reads C:/SpheroidPA/session.ini -> work_dir ->
// <work_dir>/job_trigger.ini (written by the GUI) and launches the named JOB via
// Jobs_RunJobByName. It resolves/validates the name against the project first so a
// typo aborts cleanly instead of launching nothing (or the wrong job).
//
// job_trigger.ini ([job] section):
//   project = NIS-E project DB name (default "IMAGEN" if the key is empty/missing)
//   name    = the JOB name, e.g. "Step1_Locate_via_scan" or "step3_zstack_PA"
//
// LASER SAFETY: for name == "step3_zstack_PA" the launched JOB fires the 850 nm PA
// activation laser. The GUI gates that (operator confirms A1 on, dichroic/OC prep
// via nis_macro_pa_setup, etc.); THIS macro just launches whatever job name it is
// handed -- it does no gating of its own.
//
// Jobs_RunJobByName "requires JOBS Editor" per the NIS-E docs (params: ProjDbName,
// ProjDbJobName -- "Runs the specified job"). If the JOBS Editor license is missing
// the documented fallback is _Jobs_RunJobOrWizardByName(project, name); do NOT use
// it here -- switch to it only after confirming the license state on the rig.
//
// Rig dialect (verified, same as nis_macro_pa_setup.mac): single main() only (no
// user functions/globals); CRLF + ASCII; Int_GetKeyString (buf[0]=0 before EACH
// read -- a missing key leaves the buffer unchanged); sprintf args as ONE quoted
// comma-list of variable names. Does NOT write cmd_done.ini -- the dispatcher does
// that when this runs via action_id 10.
// ============================================================================

int main()
{
    char cfg[256];
    char work_dir[256];
    char trigger_path[256];
    char project[128];
    char name[128];
    char msg[256];
    char json_path[256];
    char json[4000];
    char mbuf[512];
    int64 jobkey;
    int64 runkeys[8];
    int nr;

    strcpy(cfg, "C:/SpheroidPA/session.ini");
    work_dir[0] = 0;
    Int_GetKeyString(cfg, "paths", "work_dir", work_dir, 256);
    if( work_dir[0] == 0 )
    {
        SetCommandText("session.ini has no work_dir.\nRun GUI Step 3 first.");
        WideCharToMultiByte(mbuf, "session.ini has no work_dir.\nRun GUI Step 3 first.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("session.ini has no work_dir.\nRun GUI Step 3 first."));
        return FALSE;
    }

    strcpy(trigger_path, work_dir);
    strcat(trigger_path, "/job_trigger.ini");
    if( ExistFile(trigger_path) != TRUE )
    {
        SetCommandText("job_trigger.ini not found in work_dir.\nLaunch a JOB from the GUI first.");
        WideCharToMultiByte(mbuf, "job_trigger.ini not found in work_dir.\nLaunch a JOB from the GUI first.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("job_trigger.ini not found in work_dir.\nLaunch a JOB from the GUI first."));
        return FALSE;
    }

    project[0] = 0;
    Int_GetKeyString(trigger_path, "job", "project", project, 128);
    if( project[0] == 0 )
        strcpy(project, "IMAGEN");

    name[0] = 0;
    Int_GetKeyString(trigger_path, "job", "name", name, 128);
    if( name[0] == 0 )
    {
        SetCommandText("job_trigger.ini [job] has no 'name'.\nPick a JOB in the GUI dropdown first.");
        WideCharToMultiByte(mbuf, "job_trigger.ini [job] has no 'name'.\nPick a JOB in the GUI dropdown first.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("job_trigger.ini [job] has no 'name'.\nPick a JOB in the GUI dropdown first."));
        return FALSE;
    }

    // Resolve the jobkey (needed ONLY for the parameterized path below). Jobs_GetJobKey
    // returns the number of RUNS and, in practice, only fills jobkey once the job has RUN.
    // A valid but NEVER-RUN job -- e.g. step3_zstack_PA, which IS defined in jobsdb.dat under
    // IMAGEN but has no output folder yet (verified 2026-07-27: present in the IMAGEN .dat,
    // just never run) -- returns nr=0, jobkey=0. That is NOT "job missing": Jobs_RunJobByName
    // launches it by name regardless of run history. So do NOT abort on jobkey==0 here -- that
    // was the false "JOB not found in project" that blocked step3_zstack_PA. (A genuinely
    // wrong name simply no-ops in Jobs_RunJobByName, which for a PA-laser job is the safe
    // failure.) Only the parameterized path truly needs a resolved jobkey; it is guarded there.
    jobkey = 0;
    nr = Jobs_GetJobKey(project, name, &jobkey, runkeys, 8);

    // If the GUI wrote job_params.json (a Unicode/UTF-16 JSON of "<Task>.<Param>": value
    // pairs -- e.g. a WellSelection well, or an OC/folder override), run the job WITH those
    // parameters via Jobs_RunJobInitParam, which SETS the params AND launches the run.
    // ReadFile + Jobs_RunJobInitParam is the documented pattern (Example 18); the file MUST
    // be Unicode (the GUI writes UTF-16). No params file -> plain Jobs_RunJobByName
    // (unchanged). The file is consumed (deleted) so a stale one can't parameterise the
    // next launch.
    strcpy(json_path, work_dir);
    strcat(json_path, "/job_params.json");
    if( ExistFile(json_path) == TRUE )
    {
        // Parameterized launch needs a resolved jobkey. Jobs_GetJobKey only fills it once the
        // job has RUN (see note above), so a never-run job can't be parameterized on its first
        // launch. Tell the operator to run it once, rather than silently launching unparameterized.
        if( jobkey == 0 )
        {
            sprintf(msg, "Can't set JOB parameters for '%s' in '%s': jobkey unresolved.\nJobs_GetJobKey needs a PRIOR run -- run '%s' once in JOBS Explorer, then the GUI can launch it with the well parameter.", "name,project,name");
            SetCommandText(msg);
            WideCharToMultiByte(mbuf, msg);
            WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen(msg));
            return FALSE;
        }
        json[0] = 0;
        ReadFile(json_path, json, 4000);
        sprintf(msg, "SpheroidPA run_job: launching JOB '%s' with parameters...", "name");
        SetCommandText(msg);
        Jobs_RunJobInitParam(jobkey, json);
        DeleteFile(json_path);
        sprintf(msg, "Launched JOB '%s' (project '%s') with GUI parameters.", "name,project");
    }
    else
    {
        sprintf(msg, "SpheroidPA run_job: launching JOB '%s'...", "name");
        SetCommandText(msg);
        Jobs_RunJobByName(project, name);
        sprintf(msg, "Launched JOB '%s' in project '%s'.", "name,project");
    }

    // No modal WaitText on success -- it blocks the automated GUI->dispatcher workflow
    // (the operator had to click Continue after every launch). Report in the command bar
    // instead so the run is non-blocking. Errors above still WaitText (they need attention).
    SetCommandText(msg);
    return TRUE;
}
