// ============================================================================
// nis_macro_pa_setup.mac -- SpheroidPA photoactivation SETUP (prep only)
//
// Reads C:/SpheroidPA/session.ini -> work_dir -> pa_trigger.ini (written by GUI
// Step 4 "Run Photoactivation Job") and prepares the rig for the step3_zstack_PA
// JOB. It does NOT photoactivate and does NOT run the job -- it only sets the
// hardware state so the operator can then hit Run on the job in JOBS Explorer.
//
// Actions (each gated by a flag in pa_trigger.ini):
//   1. Stg_RemoveInterlock()            -- clear the A1 laser interlock (REQUIRED
//                                           before imaging/activation).
//   2. SelectOptConf(optical_config)    -- the 850 nm activation OC.
//   3. Stg_PFSInsertExtractDM(0)         -- dichroic mirror OUT (extract PFS DM).
//   4. (optional) Stg_SetMultiLaserPower -- force the 850 line to power_pct; only
//                                           if you set LASER_NAME below, else the
//                                           OC's own power loop sets the power.
//   5. Confocal_SetScanArea(zoom,0,0,0,1) -- centred zoom-N square (offset 0 =
//                                           field centre = the centred spheroid).
//
// Rig dialect (verified): single main() only; CRLF + ASCII; Int_GetKeyString +
// atof for INI values; char[] paths/names; sprintf args as one quoted name list.
//
// PREREQ: SpheroidPA Steps 1-3 done (spheroid centred); A1 MP active; 20X; the
// GUI Step 4 "Run Photoactivation Job" clicked (writes pa_trigger.ini).
// ============================================================================

#define SEC "photoactivation"

int main()
{
    char cfg[256];
    char work_dir[256];
    char trigger_path[256];
    char oc[128];
    char numbuf[64];
    char laser_name[64];
    char msg[256];
    char mbuf[512];
    char save_dir[256];
    char save_prefix[128];
    char save_stem[512];   // >= save_dir(256) + "/" + save_prefix(128), with margin
    double zoom, power;
    int laser_line;

    // ---- EDIT to also force laser power from the macro ----------------------
    //   Leave LASER_NAME empty ("") to let the OC's power loop set the power.
    //   To force it: set your A1 multi-laser unit name + the 850 nm line index.
    strcpy(laser_name, "");      // e.g. "LU-N4 / Laser" -- your multi-laser name
    laser_line = 0;              // index of the 850 nm line in that unit
    // -------------------------------------------------------------------------

    strcpy(cfg, "C:/SpheroidPA/session.ini");
    work_dir[0] = 0;
    Int_GetKeyString(cfg, "paths", "work_dir", work_dir, 256);
    if( work_dir[0] == 0 )
    {
        SetCommandText("session.ini has no work_dir.\nRun GUI Step 3 first.");
        WideCharToMultiByte(mbuf, "session.ini has no work_dir.\nRun GUI Step 3 first.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("session.ini has no work_dir.\nRun GUI Step 3 first."));
        return FALSE;
    }
    strcpy(trigger_path, work_dir);
    strcat(trigger_path, "/pa_trigger.ini");
    if( ExistFile(trigger_path) != TRUE )
    {
        SetCommandText("pa_trigger.ini not found in work_dir.\nClick 'Run Photoactivation Job' in GUI Step 4 first.");
        WideCharToMultiByte(mbuf, "pa_trigger.ini not found in work_dir.\nClick 'Run Photoactivation Job' in GUI Step 4 first.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("pa_trigger.ini not found in work_dir.\nClick 'Run Photoactivation Job' in GUI Step 4 first."));
        return FALSE;
    }

    oc[0] = 0;
    Int_GetKeyString(trigger_path, SEC, "optical_config", oc, 128);
    Int_GetKeyString(trigger_path, SEC, "zoom", numbuf, 64);
    zoom = atof(numbuf);
    if( zoom < 0.5 )
        zoom = 8.0;
    Int_GetKeyString(trigger_path, SEC, "power_pct", numbuf, 64);
    power = atof(numbuf);

    // A1-present guard: the A1 confocal calls below (interlock / OC / Confocal_SetScanArea)
    // CRASH NIS-E's grabber manager (access violation in v6_gnr_grabbermanager01.dll) when
    // the A1 is powered OFF. Require an explicit "A1 on" confirmation before any A1 call.
    // Clear numbuf first: Int_GetKeyString leaves it UNCHANGED when a1_on is missing, so
    // without this it kept the prior power_pct value ("30") and silently passed the guard.
    numbuf[0] = 0;
    Int_GetKeyString(trigger_path, "photoactivation", "a1_on", numbuf, 64);
    if( atof(numbuf) < 0.5 )
    {
        // Report the abort via cmd_done.ini so the dispatcher/GUI log shows it
        // (otherwise the dispatcher writes "ok" after RunMacro returns). msg is unused
        // on this path; reuse it as the cmd_done.ini path buffer.
        strcpy(msg, work_dir);
        strcat(msg, "/cmd_done.ini");
        Int_SetKeyString(msg, "command", "status", "aborted_no_a1");
        Int_SetKeyString(msg, "command", "message", "A1 not confirmed powered ON (a1_on != 1) -- aborted before any A1 call.");
        SetCommandText("A1 not confirmed powered ON (a1_on != 1).\nTick 'A1 powered on' in the GUI (or set a1_on=1 in pa_trigger.ini [photoactivation]) once the A1 is up.\nAborting to avoid an A1 grabber crash.");
        WideCharToMultiByte(mbuf, "A1 not confirmed powered ON (a1_on != 1).\nTick 'A1 powered on' in the GUI (or set a1_on=1 in pa_trigger.ini [photoactivation]) once the A1 is up.\nAborting to avoid an A1 grabber crash.");
        WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen("A1 not confirmed powered ON (a1_on != 1).\nTick 'A1 powered on' in the GUI (or set a1_on=1 in pa_trigger.ini [photoactivation]) once the A1 is up.\nAborting to avoid an A1 grabber crash."));
        return FALSE;
    }

    // 1) Clear the A1 interlock (required before imaging/activation).
    Int_GetKeyString(trigger_path, SEC, "remove_interlock", numbuf, 64);
    if( atof(numbuf) > 0.5 )
    {
        SetCommandText("PA setup: removing A1 interlock...");
        Stg_RemoveInterlock();
    }

    // 2) Switch to the 850 nm activation optical configuration.
    if( oc[0] != 0 )
    {
        SetCommandText("PA setup: selecting activation OC...");
        SelectOptConf(oc);
    }

    // 3) Dichroic mirror OUT (extract the PFS dichroic).
    Int_GetKeyString(trigger_path, SEC, "dichroic_out", numbuf, 64);
    if( atof(numbuf) > 0.5 )
        Stg_PFSInsertExtractDM(0);

    // 4) Optional explicit activation power (only if LASER_NAME set above).
    if( laser_name[0] != 0 )
        Stg_SetMultiLaserPower(laser_name, laser_line, power);

    // 5) Centred zoom-N square: XOffset=YOffset=0 -> field centre = spheroid centre.
    Confocal_SetScanArea(zoom, 0.0, 0.0, 0.0, 1.0);

    // 6) Point the ND Acquisition "Save to File" target at this run's pa/ folder, so
    //    step3_zstack_PA's activation stacks land in work/<run>/pa/ instead of wherever
    //    a previous session left the path (0715: they went to a prior user's D:\ folder
    //    and work/0715/pa/ stayed EMPTY -- the delivered PA dose was un-auditable).
    //    The JOB saves through the ND experiment, so this is the lever that redirects it.
    //    ND_DefineExperiment's first 5 args are the T/XY/Z/L dimension flags: the PA job
    //    uses Time (loops), XY (imported multipoint) and Z (stack) -- keep all TRUE so we
    //    only change the destination, not the experiment shape (rig-confirmed 2026-08-07:
    //    T/M/Z/lambda all survived the call).
    //
    //    Arg 6 is a full FILE PATH STEM, not a directory. NIS splits it into the dialog's
    //    Path (up to the last separator) and Filename (last segment + ".nd2"), and arg 7
    //    is NOT the filename. Passing the bare folder ".../0807/pa" gave
    //    Path ".../0807/" + Filename "pa.nd2" -- stacks landing NEXT TO pa/, not in it
    //    (rig-observed 2026-08-07). So append the prefix to build the stem, matching
    //    nis_macro_pa_savepath.mac. Getting this wrong here is worse than in that macro:
    //    re-running PA Setup after the path was corrected would silently re-break it.
    save_dir[0] = 0;
    Int_GetKeyString(trigger_path, SEC, "save_dir", save_dir, 256);
    if( save_dir[0] != 0 )
    {
        save_prefix[0] = 0;
        Int_GetKeyString(trigger_path, SEC, "save_prefix", save_prefix, 128);
        if( save_prefix[0] == 0 )
            strcpy(save_prefix, "PA");
        strcpy(save_stem, save_dir);
        strcat(save_stem, "/");
        strcat(save_stem, save_prefix);
        ND_DefineExperiment(TRUE, TRUE, TRUE, TRUE, TRUE, save_stem, save_prefix, 0, FALSE, FALSE, FALSE);
        sprintf(msg, "PA setup: ND save stem -> %s", "save_stem");
        SetCommandText(msg);
    }

    // 7) Report; operator then runs step3_zstack_PA in JOBS Explorer.
    sprintf(msg, "PA setup done: OC '%s', zoom %.0f centred, dichroic OUT, interlock cleared.\nND save -> pa/ folder.\nNow run step3_zstack_PA in JOBS Explorer.", "oc,zoom");
    SetCommandText(msg);
    WideCharToMultiByte(mbuf, msg);
    WriteFile("C:/SpheroidPA/debug/macro_msg.txt", mbuf, strlen(msg));
    SetCommandText(0);
    return TRUE;
}
